sudo tee -a /etc/suricata/rules/local.rules >/dev/null <<'EOF'

# --- IPS: блокировка крупного ICMP (PoD / туннель) из внешней сети ---
drop icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB4 IPS DROP: крупный ICMP payload"; itype:8; dsize:>200; classtype:attempted-dos; sid:1000020; rev:1;)

# --- IPS: блокировка Smurf-запросов на широковещательный адрес ---
drop icmp $EXTERNAL_NET any -> 192.168.1.255 any (msg:"LAB4 IPS DROP: Smurf-запрос"; itype:8; classtype:attempted-dos; sid:1000021; rev:1;)

# --- IPS: блокировка передачи данных внутри ICMP ---
drop icmp any any -> any any (msg:"LAB4 IPS DROP: HTTP внутри ICMP"; itype:8; content:"HTTP"; classtype:policy-violation; sid:1000022; rev:1;)
EOF
